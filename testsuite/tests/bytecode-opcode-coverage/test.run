if [ ${os_type} = 'Win32' ]; then
  ocamlrun=$(cygpath "${ocamlrun}")
fi

"${ocamlrun}" "${ocamlsrcdir}/tools/dumpobj" -nobanners "${program}" \
  | tr -d '\r' | grep '^ *[0-9]' | awk '{print $2}' | sort -u > emitted.txt

grep 'OPCODE(' "${ocamlsrcdir}/runtime/caml/opcodes.h" \
  | sed 's/.*OPCODE(\([A-Z0-9_]*\)).*/\1/' | sort > all.txt

comm -23 all.txt emitted.txt > "${output}"
